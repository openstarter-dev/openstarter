{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build", "transit"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "src/routeTree.gen.ts", ".output/**"]
    },
    "check-types": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"]
    },
    "test:coverage": {
      "dependsOn": ["transit"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "ios": {
      "cache": false,
      "persistent": true
    },
    "android": {
      "cache": false,
      "persistent": true
    },
    "dev:electron": {
      "cache": false,
      "persistent": true
    },
    "db:push": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "db:local": {
      "cache": false
    },
    "seed:admin": {
      "cache": false
    },
    "package": {
      "dependsOn": ["build"],
      "cache": false
    },
    "release": {
      "dependsOn": ["build"],
      "cache": false
    }
  },
  "globalDependencies": ["apps/web/.env*"],
  "globalEnv": [
    "DATABASE_URL",
    "DATABASE_PROVIDER",
    "DATABASE_AUTH_TOKEN",
    "PRODUCT_NAME",
    "URL",
    "BETTER_AUTH_URL",
    "DEFAULT_LOCALE",
    "OPENSTARTER_API_URL"
  ],
  "boundaries": {
    "tags": {
      "app": {
        "dependencies": {
          "deny": ["app"]
        }
      },
      "platform:web": {
        "dependencies": {
          "deny": ["platform:mobile", "platform:extension"]
        }
      },
      "platform:mobile": {
        "dependencies": {
          "deny": ["platform:web", "platform:extension"]
        }
      },
      "platform:extension": {
        "dependencies": {
          "deny": ["platform:web", "platform:mobile"]
        }
      },
      "core": {
        "dependencies": {
          "deny": ["platform:mobile", "platform:extension", "app"]
        }
      }
    }
  }
}
