# openstarter 环境变量模板（全仓库唯一 env 事实源）
# 用法：cp apps/web/.env.example apps/web/.env（或 pnpm env:init）
# 留空即不启用；生产取值见 apps/web/.env.production.example

# --- 基础 ---
# d1（默认）| postgres；d1 在本地自动回退到仓库根的 local.db
DATABASE_PROVIDER=d1
DATABASE_URL=file:local.db

# 应用 origin：auth 回调、SSR canonical、邮件链接、其它端 API base 都以它为准
VITE_APP_URL=http://localhost:3000

# 生成：openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-a-strong-secret-at-least-32-chars

# --- 邮件（留空则内容打到服务端日志）---
RESEND_API_KEY=
EMAIL_FROM=

# --- OAuth（成对填写才启用）---
# 回调：${VITE_APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 回调：${VITE_APP_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# client id = Services ID，secret = client_secret JWT
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=

# --- AI（可选；也可在 Admin → Settings → AI 配置）---
# New API 中转站，Base URL 需带 /v1
NEWAPI_BASE_URL=
NEWAPI_API_KEY=
REPLICATE_API_TOKEN=

# --- 跨端来源白名单（CSRF 原点校验）---
# 默认只信任：VITE_APP_URL 自身 origin、MOBILE_APP_SCHEME://、Apple 登录域名。
# 扩展以 Bearer 桥接会话时不需要下面两项；仅当浏览器扩展页面直接发起带 cookie 的
# 请求时，才填具体扩展 ID。
EXTENSION_ORIGIN=
# 额外来源，逗号分隔；用于自建域名、局域网调试（如 http://192.168.1.10:3000）
TRUSTED_ORIGINS=
# 移动端深链 scheme，需与 apps/mobile/app.config.ts 的 scheme 一致
MOBILE_APP_SCHEME=openstarter
