# ─────────────────────────────────────────────────────────────────────────────
# openstarter / apps/web 环境变量模板 —— 本地开发（全仓库唯一 env 事实源）
#
# 用法：`pnpm env:init`（或 cp 本文件为 apps/web/.env）后直接 pnpm dev。
# 密钥会自动生成；其余留空即"不启用"，应用零配置仍可启动。
# 生产部署对照 apps/web/.env.production.example（Cloudflare Workers 走 wrangler vars）。
#
# 为什么只在这里配置：
#   · web 自身经 Vite + dotenv（cwd=apps/web）读取本文件，无需任何外层 env 包装；
#   · packages/db 的运行时驱动、drizzle-kit 配置、db 脚本都直接读取本文件；
#   · extension / mobile / mini-app / cli / desktop 在构建期读取本文件的
#     `VITE_APP_URL`（见下）派生各自的 API 地址 —— 其他端不维护共享变量。
#   · 刻意不使用 Vite 的 .env.development / .env.production：服务端 runtime 与上述
#     其他端都只读 .env，按 mode 拆文件会让它们读到不同的值。
# ─────────────────────────────────────────────────────────────────────────────


# === 基础（必填） ===========================================================
# 数据库默认使用 Cloudflare D1（sqlite 方言）。
#   · 生产（Workers）：走 wrangler 的 d1_databases 绑定 DB，见 wrangler.example.jsonc。
#   · 本地开发（node）：自动回退到同 schema 的本地 sqlite 文件 local.db（仓库根目录），
#     由 pnpm db:migrate / db:push 建库，行为与 D1 一致，无需任何外部数据库。
# DATABASE_PROVIDER 可选值：d1（默认）| postgres（自托管/Hyperdrive 时才需要改）。
DATABASE_PROVIDER=d1
DATABASE_URL=file:local.db

# 应用对外地址（origin）—— better-auth 的 baseURL（回调/跳转 + origin 校验）、
# SSR 的 canonical / og:url、邮件与邀请链接、以及 extension/mobile/mini-app 派生
# 各自的 API base，全都以这一处为准。
#   · 本地开发默认 http://localhost:3000，不需要改；
#   · 真机 / 局域网调试改成开发机局域网 IP（如 http://192.168.1.5:3000）；
#   · 生产域名不写在这里 —— 见 apps/web/.env.production.example。
# 解析顺序见 packages/shared/src/app-url.ts：VITE_APP_URL → APP_URL → BETTER_AUTH_URL → URL。
# 注意：VITE_ 变量会被 Vite 内联进客户端产物，故只供服务端/构建期读取；
#       浏览器端要"当前 origin"请用 window.location.origin（见 apps/web/src/lib/page-head.ts）。
VITE_APP_URL=http://localhost:3000

# Better-Auth 密钥与官方变量名（BETTER_AUTH_URL 降级为兼容 alias，仅在上面的
# VITE_APP_URL 未设置时生效）。
# 生成：openssl rand -base64 48（≥32 字符）
# BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-strong-secret-at-least-32-chars

# 站点品牌与默认语言（web / 邮件 / 后台共用）
PRODUCT_NAME=OpenStarter
DEFAULT_LOCALE=en


# === 邮件（可选；缺失回落 console 驱动，链接/验证码直接打到服务端日志） =========
# 用于：密码重置 / 邮箱验证 / 改邮箱确认 / Magic Link / Email OTP / 删除账户验证。
# 配置任一项后即启用 Resend 投递；两者都留空则邮件类功能在 dev 仍可用（仅打印）。
#
# 获取 RESEND_API_KEY：https://resend.com/api-keys （需验证发送域名）
RESEND_API_KEY=
# 发信地址，建议形如 `Openstarter <noreply@yourdomain.com>`
EMAIL_FROM=


# === OAuth 社交登录（成对齐全才注册对应 provider；缺失则按钮不渲染） ===========
#
# Google —— https://console.cloud.google.com/apis/credentials 创建 OAuth 2.0 客户端
#   Authorized redirect URI：${VITE_APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub —— https://github.com/settings/developers 新建 OAuth App
#   Authorization callback URL：${VITE_APP_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Apple —— https://developer.apple.com/account/resources/identifiers/list
#   需 Sign in with Apple Capability；client id 即 Services ID；secret 为 client_secret JWT。
#   还需 Bundle Identifier（用于移动端 native 流，Web 可填 Bundle ID 占位）。
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=


# === AI 生成（可选） ==========================================================
# New API 中转站：文本 LLM / 图片 / 视频共用一组凭证（也可在 Admin → Settings → AI 配置）。
# Base URL 需带 /v1；只填域名时后端会自动补 /v1。
NEWAPI_BASE_URL=
NEWAPI_API_KEY=
#
# 其它渠道（OpenAI / Anthropic / Replicate / Fal）建议在后台配置；
# 其中 REPLICATE_API_TOKEN 支持环境变量兜底。
REPLICATE_API_TOKEN=


# === 前端编译期开关（Vite；控制 OAuth 按钮显示 / One Tap 渲染） =================
# 注意：以 VITE_ 前缀在编译期注入，不会发起运行时请求；
#       与服务端 *_CLIENT_ID 独立——前者只决定**按钮是否渲染**，后者决定**能否真的完成登录**。
#       推荐做法：把对应 server-side `*_CLIENT_ID` 直接复制过来。
#
# 控制 Google 按钮显示 + 启用 Google One Tap（仅当 Google provider 服务端也已配置时生效）
VITE_GOOGLE_CLIENT_ID=
# 控制 GitHub 按钮显示
VITE_GITHUB_ENABLED=
# 控制 Apple 按钮显示
VITE_APPLE_ENABLED=
