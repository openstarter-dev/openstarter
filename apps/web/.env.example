# ─────────────────────────────────────────────────────────────────────────────
# openstarter / apps/web 环境变量样例（全仓库唯一 env 事实源）
#
# 复制为 apps/web/.env 后按需填写。除 `DATABASE_URL` / `BETTER_AUTH_SECRET` /
# `BETTER_AUTH_URL` 外，其余均可留空（留空 → 能力以"不启用"姿态呈现，应用零配置仍可启动）。
#
# 为什么只在这里配置：
#   · 根脚本 `pnpm with-env`（dotenv -e apps/web/.env）把本文件注入所有 turbo 任务；
#   · packages/db 的 drizzle-kit 配置直接读取本文件；
#   · extension / mobile / mini-app / cli / desktop 在构建期读取本文件的 `URL`
#     派生各自的 API 地址 —— 其他端不再维护共享变量。
#   · 需要按 Vite 模式区分时，可另建 `.env.development` / `.env.production`，
#     Vite 会按 mode 自动加载（优先级高于 `.env`）；日常只需维护 `.env` 一个文件。
# ─────────────────────────────────────────────────────────────────────────────


# === 基础（必填） ===========================================================

# web 应用对外地址（同时也是 API 源）。其他端据此派生 base URL。
# 本地开发用 http://localhost:3000；真机/局域网调试改成开发机局域网 IP。
URL=http://localhost:3000

# 数据库默认使用 Cloudflare D1（sqlite 方言）。
#   · 生产（Workers）：走 wrangler 的 d1_databases 绑定 DB，见 wrangler.example.jsonc。
#   · 本地开发（node）：自动回退到同 schema 的本地 sqlite 文件 local.db（仓库根目录），
#     由 pnpm db:migrate / db:push 建库，行为与 D1 一致，无需任何外部数据库。
# DATABASE_PROVIDER 可选值：d1（默认）| postgres（自托管/Hyperdrive 时才需要改）。
DATABASE_PROVIDER=d1
DATABASE_URL=file:local.db

# Better-Auth 密钥与会话 URL。
# 生成：openssl rand -base64 48（≥32 字符）
BETTER_AUTH_SECRET=replace-with-a-strong-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000

# 站点品牌与默认语言（web / 邮件 / 后台共用）
PRODUCT_NAME=OpenStarter
DEFAULT_LOCALE=en


# === 邮件（可选；缺失回落 console 驱动，链接/验证码直接打到服务端日志） =========
# 用于：密码重置 / 邮箱验证 / 改邮箱确认 / Magic Link / Email OTP / 删除账户验证。
# 配置任一项后即启用 Resend 投递；两者都留空则邮件类功能在 dev 仍可用（仅打印）。
#
# 获取 RESEND_API_KEY：https://resend.com/api-keys （需验证发送域名）
RESEND_API_KEY=
# 发信地址，建议形如 `Openstarter <noreply@yourdomain.com>`
EMAIL_FROM=


# === OAuth 社交登录（成对齐全才注册对应 provider；缺失则按钮不渲染） ===========
#
# Google —— https://console.cloud.google.com/apis/credentials 创建 OAuth 2.0 客户端
#   Authorized redirect URI：${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub —— https://github.com/settings/developers 新建 OAuth App
#   Authorization callback URL：${BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Apple —— https://developer.apple.com/account/resources/identifiers/list
#   需 Sign in with Apple Capability；client id 即 Services ID；secret 为 client_secret JWT。
#   还需 Bundle Identifier（用于移动端 native 流，Web 可填 Bundle ID 占位）。
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=


# === AI 生成（可选） ==========================================================
# New API 中转站：文本 LLM / 图片 / 视频共用一组凭证（也可在 Admin → Settings → AI 配置）。
# Base URL 需带 /v1；只填域名时后端会自动补 /v1。
NEWAPI_BASE_URL=
NEWAPI_API_KEY=
#
# 其它渠道（OpenAI / Anthropic / Replicate / Fal）建议在后台配置；
# 其中 REPLICATE_API_TOKEN 支持环境变量兜底。
REPLICATE_API_TOKEN=


# === 前端编译期开关（Vite；控制 OAuth 按钮显示 / One Tap 渲染） =================
# 注意：以 VITE_ 前缀在编译期注入，不会发起运行时请求；
#       与服务端 *_CLIENT_ID 独立——前者只决定**按钮是否渲染**，后者决定**能否真的完成登录**。
#       推荐做法：把对应 server-side `*_CLIENT_ID` 直接复制过来。
#
# 控制 Google 按钮显示 + 启用 Google One Tap（仅当 Google provider 服务端也已配置时生效）
VITE_GOOGLE_CLIENT_ID=
# 控制 GitHub 按钮显示
VITE_GITHUB_ENABLED=
# 控制 Apple 按钮显示
VITE_APPLE_ENABLED=
