{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openstarter",

  // TanStack Start server entry — the vite plugin bundles it into the worker.
  "main": "@tanstack/react-start/server-entry",

  "routes": [{ "pattern": "<your-domain.com>", "custom_domain": true }],

  "workers_dev": false,
  "preview_urls": false,

  "compatibility_flags": ["nodejs_compat"],
  // Must be >= 2025-04-01 so vars/secrets auto-populate `process.env` in workerd.
  "compatibility_date": "2026-08-01",

  "observability": {
    "enabled": true,
  },

  "vars": {
    "DATABASE_PROVIDER": "d1",
    "NODE_ENV": "production",
    "VITE_APP_URL": "https://<your-domain.com>",
    "VITE_APP_NAME": "OpenStarter",
    "VITE_DEFAULT_LOCALE": "en",
    "EMAIL_AUTH_ENABLED": "true",
    "EMAIL_VERIFICATION_REQUIRED": "false",
    "INVITE_CODE_REQUIRED": "false",
    "ANONYMOUS_AUTH_ENABLED": "false",
    "GOOGLE_ONE_TAP_ENABLED": "false",
    "MAGIC_LINK_ENABLED": "false",
    "EMAIL_OTP_ENABLED": "false",
    "MAGIC_LINK_EXPIRES_IN": "1800",
    "EMAIL_OTP_EXPIRES_IN": "300",
    "REFERRAL_ENABLED": "true",
    "REFERRAL_DEFAULT_RATE_BPS": "1000",
    "REFERRAL_MIN_SETTLE_CREDITS": "100",
    "VITE_EMAIL_AUTH_ENABLED": "true",
    "VITE_GOOGLE_AUTH_ENABLED": "false",
    "VITE_GITHUB_AUTH_ENABLED": "false",
    "VITE_APPLE_AUTH_ENABLED": "false",
    "VITE_MAGIC_LINK_ENABLED": "false",
    "VITE_EMAIL_OTP_ENABLED": "false",
    "VITE_PASSWORD_RESET_ENABLED": "false",
    "VITE_EMAIL_VERIFICATION_ENABLED": "false",
    "VITE_INVITE_CODE_REQUIRED": "false",
    "VITE_ANONYMOUS_AUTH_ENABLED": "false",
    "VITE_GOOGLE_ONE_TAP_ENABLED": "false",
    "VITE_GOOGLE_CLIENT_ID": "",
    "VITE_CRISP_ENABLED": "false",
    "VITE_CRISP_WEBSITE_ID": "",
    "VITE_TAWK_ENABLED": "false",
    "VITE_TAWK_PROPERTY_ID": "",
    "VITE_TAWK_WIDGET_ID": "default",
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openstarter-db",
      "database_id": "<output-of-wrangler-d1-create>",
      "migrations_dir": "../../packages/api/src/db/migrations/sqlite",
    },
  ],
}
