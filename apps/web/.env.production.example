# ─────────────────────────────────────────────────────────────────────────────
# openstarter / apps/web 环境变量模板 —— 生产环境
#
# 键名与 .env.example（本地开发）一致，只换取值。两种用法：
#   · Cloudflare Workers（默认部署方式）：本文件当 checklist 用 ——
#     普通变量填进 apps/web/wrangler.jsonc 的 vars（模板见 wrangler.example.jsonc），
#     密钥用 `wrangler secret put <NAME>`。Workers 运行期只读 wrangler vars，不读 .env。
#   · 自托管 Node：cp apps/web/.env.production.example apps/web/.env 后填真实值；
#     服务端 runtime 通过 dotenv 只读 .env，不会自动加载 .env.production。
#
# 注意：仓库刻意不使用 Vite 的 .env.development / .env.production —— 除 Vite 客户端外
# 的所有消费方（packages/db、extension、mobile、mini-app、seed 脚本）都只读 .env，
# 按 mode 拆文件会让它们读到不同的值。
# ─────────────────────────────────────────────────────────────────────────────


# === 必填 ====================================================================

# 生产站点地址（HTTPS，无末尾斜杠，必须与 wrangler routes 的域名一致）：
# better-auth baseURL / SSR canonical / 邮件链接 / 其他端派生 API base 都以此为准。
VITE_APP_URL=https://your-domain.com

# Better-Auth 签名密钥（≥32 字符）：openssl rand -base64 48
BETTER_AUTH_SECRET=

# 后台保存的第三方密钥的加密密钥（AES-256-GCM，缺失时写入秘密会直接报错）：
# openssl rand -base64 32
# 仅服务端使用，Cloudflare 上务必用 secret 而非明文 var。
CONFIG_ENCRYPTION_KEY=

# 数据库：d1（默认，Workers 运行期走 wrangler 的 d1_databases 绑定）| postgres
DATABASE_PROVIDER=d1
# 仅 postgres 需要；D1 的 prod 迁移改用文件末的 CLOUDFLARE_* 凭据。
# DATABASE_URL=postgres://user:password@host:5432/db


# === 站点 ====================================================================

PRODUCT_NAME=OpenStarter
DEFAULT_LOCALE=en

# Better-Auth 官方变量名，保留为兼容 alias；设置了 VITE_APP_URL 时无需填写。
# BETTER_AUTH_URL=https://your-domain.com


# === 邮件（生产建议必配；缺失时验证码/重置链接只打印到服务端日志） ============

RESEND_API_KEY=
# 需先在 Resend 验证发信域名
EMAIL_FROM=OpenStarter <no-reply@your-domain.com>


# === OAuth 社交登录（成对齐全才注册对应 provider） ============================
# 回调地址必须与 VITE_APP_URL 同域，否则 better-auth 的 trustedOrigins 校验会拒绝。

# Google：Authorized redirect URI = ${VITE_APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub：Authorization callback URL = ${VITE_APP_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Apple：client id = Services ID；secret = client_secret JWT
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=

# 前端按钮显示开关（与服务端 *_CLIENT_ID 独立：前者只决定是否渲染按钮）
VITE_GOOGLE_CLIENT_ID=
VITE_GITHUB_ENABLED=
VITE_APPLE_ENABLED=


# === AI 生成（可选；也可在 Admin → Settings → AI 配置） ======================

# New API 中转站：Base URL 需带 /v1
NEWAPI_BASE_URL=
NEWAPI_API_KEY=

# 其它渠道（OpenAI / Anthropic / Replicate / Fal）建议在后台配置；
# 其中 REPLICATE_API_TOKEN 支持环境变量兜底。
REPLICATE_API_TOKEN=


# === 生产库迁移（仅执行 pnpm db:migrate:prod 时需要，不是运行时变量） ==========
# 见 packages/db/drizzle.config.prod.ts；在 CI 里以环境变量注入，不要写进仓库：
#   · D1：CLOUDFLARE_ACCOUNT_ID / CLOUDFLARE_DATABASE_ID / CLOUDFLARE_API_TOKEN
#   · postgres：DATABASE_PROVIDER=postgres + DATABASE_URL
