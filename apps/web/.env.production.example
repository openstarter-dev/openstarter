# openstarter 环境变量模板 —— 生产（键名同 .env.example，只换取值）
# Cloudflare Workers：普通值填进 wrangler.jsonc 的 vars，密钥用 wrangler secret put
# 自托管 Node：cp 本文件为 apps/web/.env 后填真实值
# 注意：不用 Vite 的 .env.production，服务端与 db/seed 脚本只读 .env

# --- 基础（必填）---
# 运行环境标识。Worker 不会自动注入；缺失时 better-auth 视为非生产（不限流），
# 认证 env 预设也会回退成 development（额外信任 localhost 来源）。
NODE_ENV=production

# HTTPS，无末尾斜杠，且与 wrangler routes 域名一致
VITE_APP_URL=https://your-domain.com

# 生成：openssl rand -base64 48
BETTER_AUTH_SECRET=

# 后台密钥的加密密钥（AES-256-GCM）；仅服务端使用，缺失时写入秘密直接报错
# 生成：openssl rand -base64 32
CONFIG_ENCRYPTION_KEY=

# d1（默认，走 wrangler 的 d1_databases 绑定）| postgres
DATABASE_PROVIDER=d1
# 仅 postgres 需要；D1 的 prod 迁移用文件末的 CLOUDFLARE_* 凭据
# DATABASE_URL=postgres://user:password@host:5432/db

# --- 邮件（建议必配；留空只打到服务端日志）---
RESEND_API_KEY=
# 需先在 Resend 验证发信域名
EMAIL_FROM=OpenStarter <no-reply@your-domain.com>

# --- OAuth（成对填写才启用；回调必须与 VITE_APP_URL 同域）---
# 回调：${VITE_APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 回调：${VITE_APP_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# client id = Services ID，secret = client_secret JWT
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=

# --- 浏览器扩展 ---
# 扩展页面 origin（chrome-extension://<id>）。生产建议钉到具体扩展 ID，
# 留空意味着信任任意扩展 origin。
EXTENSION_ORIGIN=

# --- AI（可选；也可在 Admin → Settings → AI 配置）---
# New API 中转站，Base URL 需带 /v1
NEWAPI_BASE_URL=
NEWAPI_API_KEY=
REPLICATE_API_TOKEN=

# --- 生产库迁移（仅 pnpm db:migrate:prod 需要，非运行时变量；CI 注入）---
#   D1：CLOUDFLARE_ACCOUNT_ID / CLOUDFLARE_DATABASE_ID / CLOUDFLARE_API_TOKEN
#   postgres：DATABASE_PROVIDER=postgres + DATABASE_URL
