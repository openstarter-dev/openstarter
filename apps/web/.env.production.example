# openstarter 环境变量模板 —— 生产（键名同 .env.example，只换取值）
# Cloudflare Workers：普通值填进 wrangler.jsonc 的 vars，密钥用 wrangler secret put
# 自托管 Node：cp 本文件为 apps/web/.env 后填真实值
# 注意：不用 Vite 的 .env.production，服务端与 db/seed 脚本只读 .env

# --- 基础（必填）---
# 运行环境标识。Worker 不会自动注入；缺失时 better-auth 视为非生产（不限流），
# 认证 env 预设也会回退成 development（额外信任 localhost 来源）。
NODE_ENV=production

# HTTPS，无末尾斜杠，且与 wrangler routes 域名一致
VITE_APP_NAME=openstarter
VITE_APP_URL=https://your-domain.com

# 生成：openssl rand -base64 48
BETTER_AUTH_SECRET=

# --- 服务端认证开关（Cloudflare 填 wrangler vars，Node 填本文件）---
EMAIL_AUTH_ENABLED=true
EMAIL_VERIFICATION_REQUIRED=false
INVITE_CODE_REQUIRED=false
ANONYMOUS_AUTH_ENABLED=false
GOOGLE_ONE_TAP_ENABLED=false
MAGIC_LINK_ENABLED=false
EMAIL_OTP_ENABLED=false
MAGIC_LINK_EXPIRES_IN=1800
EMAIL_OTP_EXPIRES_IN=300
# OAuth 开关省略时按 CLIENT_ID/SECRET 是否齐全自动判断；也可显式覆盖：
# GOOGLE_AUTH_ENABLED=true
# GITHUB_AUTH_ENABLED=true
# APPLE_AUTH_ENABLED=true
INITIAL_ROLE_ENABLED=false
INITIAL_ROLE_NAME=

# --- Web 前端全局配置（apps/web/src/config/index.ts 读取）---
VITE_EMAIL_AUTH_ENABLED=true
VITE_GOOGLE_AUTH_ENABLED=false
VITE_GITHUB_AUTH_ENABLED=false
VITE_APPLE_AUTH_ENABLED=false
VITE_MAGIC_LINK_ENABLED=false
VITE_EMAIL_OTP_ENABLED=false
VITE_PASSWORD_RESET_ENABLED=false
VITE_EMAIL_VERIFICATION_ENABLED=false
VITE_INVITE_CODE_REQUIRED=false
VITE_ANONYMOUS_AUTH_ENABLED=false
VITE_GOOGLE_ONE_TAP_ENABLED=false
VITE_GOOGLE_CLIENT_ID=

# Web 分析统计与客服组件
VITE_GA_MEASUREMENT_ID=
VITE_PLAUSIBLE_DOMAIN=
VITE_PLAUSIBLE_SRC=
VITE_CRISP_ENABLED=false
VITE_CRISP_WEBSITE_ID=
VITE_TAWK_ENABLED=false
VITE_TAWK_PROPERTY_ID=
VITE_TAWK_WIDGET_ID=default

# d1（默认，走 wrangler 的 d1_databases 绑定）| postgres
DATABASE_PROVIDER=d1
# 仅 postgres 需要；D1 的 prod 迁移用文件末的 CLOUDFLARE_* 凭据
# DATABASE_URL=postgres://user:password@host:5432/db

# --- 邮件（建议必配；留空只打到服务端日志）---
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# 需先在 Resend 验证发信域名
EMAIL_FROM=OpenStarter <no-reply@your-domain.com>
# CLOUDFLARE_EMAIL_API_TOKEN=
# CLOUDFLARE_EMAIL_SENDER_EMAIL=

# --- OAuth（成对填写才启用；回调必须与 VITE_APP_URL 同域）---
# 回调：${VITE_APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 回调：${VITE_APP_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# client id = Services ID，secret = client_secret JWT
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=

# --- 积分、支付与返佣（密钥请通过 wrangler secret put 注入）---
INITIAL_CREDITS_ENABLED=false
INITIAL_CREDITS_AMOUNT=0
INITIAL_CREDITS_VALID_DAYS=0
INITIAL_CREDITS_DESCRIPTION=

REFERRAL_ENABLED=true
REFERRAL_DEFAULT_RATE_BPS=1000
REFERRAL_MIN_SETTLE_CREDITS=100

DEFAULT_PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SIGNING_SECRET=
REVENUECAT_ENABLED=false
REVENUECAT_WEBHOOK_SECRET=

# --- 跨端来源白名单（CSRF 原点校验）---
# 默认只信任：VITE_APP_URL 自身 origin、MOBILE_APP_SCHEME://、Apple 登录域名。
# 扩展以 Bearer 桥接会话时不需要下面两项；仅当扩展页面直接发起带 cookie 的请求时才填。
EXTENSION_ORIGIN=
# 额外来源，逗号分隔（自建域名、预览域名等）；留空表示不加
TRUSTED_ORIGINS=
# 移动端深链 scheme，需与 apps/mobile/app.config.ts 的 scheme 一致
MOBILE_APP_SCHEME=openstarter

# --- 存储与 AI（按需配置）---
# STORAGE_ENDPOINT=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_BUCKET=
# STORAGE_PUBLIC_DOMAIN=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_BUCKET_NAME=
# R2_DOMAIN=
# INLINE_IMAGE_MAX_KB=500

# DEFAULT_AI_PROVIDER=newapi
# DEFAULT_LLM_PROVIDER=openai
# LLM_ENABLED=true
# AI_CREDITS_COST=10
# New API 中转站，Base URL 需带 /v1
NEWAPI_BASE_URL=
NEWAPI_API_KEY=
REPLICATE_API_TOKEN=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# FAL_API_KEY=

# --- 生产库迁移（仅 pnpm db:migrate:prod 需要，非运行时变量；CI 注入）---
#   D1：CLOUDFLARE_ACCOUNT_ID / CLOUDFLARE_DATABASE_ID / CLOUDFLARE_API_TOKEN
#   postgres：DATABASE_PROVIDER=postgres + DATABASE_URL
