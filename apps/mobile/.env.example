# Web 应用（同时也是 API）的源。移动端所有请求都打到它的 /api/*。
# 真机调试必须填开发机的局域网 IP —— localhost 在设备上指向设备自身，不是你的电脑。
# 模拟器/仿真器上 http://localhost:3000 可用。
#
# 留空时：apps/mobile/package.json 的 dev/android/ios 脚本经 scripts/env.mjs 自动派生
# 自 apps/web/.env 的 URL（与 web/cli/desktop/extension 同源）。此处的
# 本地 EXPO_PUBLIC_API_URL 优先级高于 web 值，故真机调试在此填写局域网 IP 即可覆盖。
EXPO_PUBLIC_API_URL=http://192.168.1.100:3000

# ---------------------------------------------------------------------------
# 移动端认证方式显隐开关（构建期固化，不再请求 web 公开配置接口）
# ---------------------------------------------------------------------------
EXPO_PUBLIC_EMAIL_AUTH_ENABLED=true
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=false
EXPO_PUBLIC_APPLE_AUTH_ENABLED=false
EXPO_PUBLIC_MAGIC_LINK_ENABLED=false
EXPO_PUBLIC_EMAIL_OTP_ENABLED=false
EXPO_PUBLIC_PASSWORD_RESET_ENABLED=false

# ---------------------------------------------------------------------------
# 移动端支付供应商（构建期 env 固化，不再由 web 管理端控制）
# ---------------------------------------------------------------------------
# EXPO_PUBLIC_BILLING_PROVIDER：revenuecat（默认，可省略）| superwall。
# 非法值启动即报错。App 是静态二进制：供应商随构建打进安装包，管理端改不了。
EXPO_PUBLIC_BILLING_PROVIDER=revenuecat

# RevenueCat SDK key（iOS 形如 appl_xxx，Android 形如 goog_xxx）。
# 平台对应键缺失时 IAP 整体降级为不可用（no-op），不报错。
EXPO_PUBLIC_REVENUECAT_APPLE_API_KEY=
EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY=

# Superwall（备胎 provider；依赖已随 @openstarter/billing-mobile 安装，启用前需真机验证）。
EXPO_PUBLIC_SUPERWALL_APPLE_API_KEY=
EXPO_PUBLIC_SUPERWALL_GOOGLE_API_KEY=
