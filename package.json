{
  "name": "openstarter",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/*/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test --concurrency=4",
    "test:coverage": "turbo test:coverage --concurrency=4",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "dev:desktop": "turbo -F desktop dev",
    "dev:extension": "turbo -F extension dev",
    "dev:mobile": "turbo -F mobile dev",
    "dev:mobile:ios": "turbo -F mobile ios",
    "dev:mobile:android": "turbo -F mobile android",
    "dev:mini-app": "turbo -F mini-app dev",
    "dev:cli": "turbo -F @openstarter/cli dev",
    "build:web": "turbo -F web build",
    "build:extension": "turbo -F extension build",
    "build:mobile": "turbo -F mobile build",
    "build:cli": "turbo -F @openstarter/cli build",
    "build:mini-app": "turbo -F mini-app build",
    "build:desktop": "turbo -F desktop build",
    "package:desktop": "turbo -F desktop package",
    "release:desktop": "turbo -F desktop release",
    "env:init": "node scripts/setup-env.mjs",
    "db:push": "turbo -F @openstarter/db db:push",
    "db:studio": "turbo -F @openstarter/db db:studio",
    "db:generate": "turbo -F @openstarter/db db:generate",
    "db:migrate": "turbo -F @openstarter/db db:migrate",
    "db:local": "turbo -F @openstarter/db db:local",
    "seed:admin": "turbo -F @openstarter/auth seed:admin",
    "gen:package": "node scripts/gen-package.mjs",
    "with-env": "dotenv -e apps/web/.env --"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "4.1.10",
    "dotenv-cli": "^11.0.0",
    "fast-check": "4.9.0",
    "jsdom": "29.1.1",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "turbo": "^2.9.16",
    "typescript": "catalog:",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@10.25.0"
}
