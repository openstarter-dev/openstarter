{
  "name": "@openstarter/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./schema": {
      "default": "./src/schema/index.ts"
    },
    "./server": {
      "default": "./src/server.ts"
    },
    "./types": {
      "default": "./src/types.ts"
    },
    "./env": {
      "default": "./src/config/env.ts"
    }
  },
  "scripts": {
    "db:setup": "node scripts/setup-schema.mjs",
    "db:local": "turso dev --db-file local.db",
    "db:push": "node scripts/setup-schema.mjs && drizzle-kit push",
    "db:generate": "node scripts/setup-schema.mjs && drizzle-kit generate",
    "db:studio": "node scripts/setup-schema.mjs && drizzle-kit studio",
    "db:migrate": "node scripts/setup-schema.mjs && drizzle-kit migrate",
    "db:generate:prod": "drizzle-kit generate --config=drizzle.config.prod.ts",
    "db:push:prod": "drizzle-kit push --config=drizzle.config.prod.ts",
    "db:migrate:prod": "drizzle-kit migrate --config=drizzle.config.prod.ts",
    "db:studio:prod": "drizzle-kit studio --config=drizzle.config.prod.ts",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@libsql/client": "0.15.15",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.1",
    "envin": "catalog:",
    "libsql": "0.5.22",
    "mysql2": "catalog:",
    "postgres": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.8",
    "fast-check": "4.9.0",
    "typescript": "catalog:",
    "vitest": "4.1.10"
  }
}
