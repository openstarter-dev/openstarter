{
  "name": "@openstarter/api",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./client": {
      "default": "./src/client/index.ts"
    },
    "./client/*": {
      "default": "./src/client/*.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.8.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@openstarter/auth": "workspace:*",
    "@openstarter/billing-web": "workspace:*",
    "@openstarter/db": "workspace:*",
    "@openstarter/shared": "workspace:*",
    "@tanstack/ai": "0.61.0",
    "@tanstack/ai-anthropic": "0.19.1",
    "@tanstack/ai-gemini": "0.33.1",
    "@tanstack/ai-openai": "0.24.1",
    "@tanstack/query-core": "^5.101.2",
    "aws4fetch": "1.0.20",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "4.1.10"
  }
}
