{
  "name": "@openstarter/api",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./auth": {
      "default": "./src/modules/auth/index.ts"
    },
    "./client": {
      "default": "./src/client/index.ts"
    },
    "./client/*": {
      "default": "./src/client/*.ts"
    }
  },
  "scripts": {
    "seed:admin": "pnpm dlx tsx scripts/seed-admin.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:prod": "drizzle-kit migrate --config=drizzle.config.prod.ts",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.22",
    "@better-auth/drizzle-adapter": "1.7.22",
    "@better-auth/expo": "1.7.22",
    "@better-auth/passkey": "1.7.22",
    "@hono/zod-validator": "^0.8.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@openstarter/auth": "workspace:*",
    "@openstarter/i18n-web": "workspace:*",
    "@openstarter/shared": "workspace:*",
    "@react-email/components": "^1.0.0",
    "@tanstack/query-core": "^5.101.2",
    "aws4fetch": "1.0.20",
    "better-auth": "1.7.22",
    "drizzle-orm": "^0.45.1",
    "hono": "4.13.8",
    "react": "catalog:",
    "react-dom": "catalog:",
    "stripe": "^18.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "drizzle-kit": "^0.31.8",
    "miniflare": "4.20260714.0",
    "typescript": "catalog:",
    "vitest": "4.1.10",
    "wrangler": "^4.98.0"
  }
}
