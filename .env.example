# ─────────────────────────────────────────────────────────────────────────────
# openstarter / 根环境变量样例
#
# 这是跨端共享变量的【唯一事实源】。复制为 .env 后仅维护此处即可。
#   · web（API 宿主）地址就是它自己 origin，不读本变量；
#   · cli / desktop 运行期读本变量，改完重启即生效；
#   · mobile / extension 在【构建期】读本变量并派生各自前缀变量（EXPO_PUBLIC_API_URL
#     / VITE_APP_URL），由构建入口自动注入——改完需重新 build，仅重启 web 不影响已构建产物。
#
# 本文件集中跨端共享变量。DATABASE_URL 通过 dotenv expansion 被 apps/web/.env 动态引用。
# BETTER_AUTH_SECRET、OAuth 密钥等 app-specific 变量仍由 apps/web/.env 维护。
# ─────────────────────────────────────────────────────────────────────────────

# 5 端共用的 API 地址（即 web 站点 origin）。
# 本地 dev 用 http://localhost:3000；真机调试需改为开发机局域网 IP（localhost 在设备上
# 指向设备自身，不是你的电脑）。
OPENSTARTER_API_URL=http://localhost:3000

# === Database ===
# 数据库连接串。DATABASE_PROVIDER 可选值：sqlite | turso | postgres | mysql | d1
DATABASE_URL=file:local.db
DATABASE_PROVIDER=sqlite

# === Shared ===
PRODUCT_NAME=OpenStarter
URL=http://localhost:3000
DEFAULT_LOCALE=en
