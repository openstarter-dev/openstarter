{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "import"],
  "env": {
    "browser": true,
    "node": true,
    "es2022": true
  },
  "globals": {
    "__dirname": "readonly"
  },
  "settings": {
    "react": {
      "version": "19.0.0"
    }
  },
  "rules": {
    "react-perf/jsx-no-new-function-as-prop": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.{ts,tsx}", "**/*.spec.{ts,tsx}"],
      "rules": {
        "@typescript-eslint/no-explicit-any": "off"
      }
    },
    {
      "files": ["packages/ui/mobile/**"],
      "rules": {
        "import/namespace": "off"
      }
    },
    {
      "files": ["**/*.ts", "**/*.tsx"],
      "excludeFiles": ["packages/api/src/db/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "drizzle-orm",
                "message": "drizzle-orm is only allowed inside packages/api/src/db. Import query operators from '../db/orm' (or '@openstarter/api/db/orm') instead. drizzle-orm 只允许在 packages/api/src/db 内直接使用，其他代码请从 '../db/orm' 导入。"
              }
            ],
            "patterns": [
              {
                "regex": "^drizzle-orm(/.*)?$",
                "message": "drizzle-orm is only allowed inside packages/api/src/db. Import query operators from '../db/orm' (or '@openstarter/api/db/orm') instead. drizzle-orm 只允许在 packages/api/src/db 内直接使用，其他代码请从 '../db/orm' 导入。"
              }
            ]
          }
        ]
      }
    }
  ]
}
